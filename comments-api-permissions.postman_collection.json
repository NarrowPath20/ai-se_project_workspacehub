    {
      "name": "Find seeded task",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "type": "string",
              "value": "{{ownerToken}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  const task = json.data.find(item => item.title === \"Audit current navigation\");",
              "  pm.test(\"Seeded task exists\", () => pm.expect(task).to.exist);",
              "  if (task) pm.collectionVariables.set(\"taskId\", task._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Find protected owner comment",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "type": "string",
