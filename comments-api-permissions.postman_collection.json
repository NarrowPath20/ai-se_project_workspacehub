              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  const comment = json.data.find(item => item.content === \"Start by mapping the routes in the main navigation.\");",
              "  pm.test(\"Protected seed comment exists\", () => pm.expect(comment).to.exist);",
              "  if (comment) pm.collectionVariables.set(\"protectedCommentId\", comment._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Member cannot edit the owner’s comment",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{protectedCommentId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "type": "string",
              "value": "{{memberToken}}"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Forbidden change\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "if (pm.response.code === 403) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(false));",
              "  pm.test(\"No response data\", () => pm.expect(json.data).to.equal(null));",
              "}"
            ]
          }
        }
      ]
    },
