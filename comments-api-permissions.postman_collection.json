    {
      "name": "Check preserved comment and deleted fixtures",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "type": "string",
              "value": "{{ownerToken}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  const protectedComment = json.data.find(item => item._id === pm.collectionVariables.get(\"protectedCommentId\"));",
              "  pm.test(\"Protected comment remains unchanged\", () => pm.expect(protectedComment && protectedComment.content).to.equal(\"Start by mapping the routes in the main navigation.\"));",
              "  pm.test(\"member fixture is gone\", () => pm.expect(json.data.map(item => item._id)).not.to.include(pm.collectionVariables.get(\"memberCommentId\")));",
              "  pm.test(\"owner fixture is gone\", () => pm.expect(json.data.map(item => item._id)).not.to.include(pm.collectionVariables.get(\"ownerCommentId\")));",
              "  pm.test(\"admin fixture is gone\", () => pm.expect(json.data.map(item => item._id)).not.to.include(pm.collectionVariables.get(\"adminCommentId\")));",
              "}"
            ]
          }
        }
