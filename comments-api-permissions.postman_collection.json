{
  "info": {
    "name": "WorkspaceHub Comments API Permissions",
    "description": "Run in order against local WorkspaceHub seeded with npm run seed. Uses temporary comments for successful mutations and verifies the seeded owner comment survives denied writes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "protectedCommentId",
      "value": ""
    },
    {
      "key": "memberCommentId",
      "value": ""
    },
    {
      "key": "ownerCommentId",
      "value": ""
    },
    {
      "key": "adminCommentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Log in as owner",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@workspacehub.dev\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  pm.test(\"Expected account role\", () => pm.expect(json.data.user.role).to.equal(\"owner\"));",
              "  pm.test(\"Token returned\", () => pm.expect(json.data.token).to.be.a(\"string\").and.not.empty);",
              "  pm.collectionVariables.set(\"ownerToken\", json.data.token);",
              "}"
            ]
          }
        }
      ]
    },
