{
  "info": {
    "name": "WorkspaceHub Comments API Edge Cases",
    "description": "Run in order against a disposable local database seeded with npm run seed. Checks request validation and removes its temporary fixture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "baseline",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Log in as seed owner",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@workspacehub.dev\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  pm.collectionVariables.set(\"token\", json.data.token);",
              "  pm.collectionVariables.set(\"ownerId\", json.data.user._id);",
              "  pm.collectionVariables.set(\"organizationId\", json.data.user.organizationId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Find seeded task",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  const task = json.data.find(item => item.title === \"Audit current navigation\");",
              "  pm.test(\"Seed task exists\", () => pm.expect(task).to.exist);",
              "  if (task) pm.collectionVariables.set(\"taskId\", task._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Record original comments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  pm.collectionVariables.set(\"baseline\", JSON.stringify(json.data.map(({ _id, content, authorId, taskId, organizationId }) => ({ _id, content, authorId, taskId, organizationId }))));",
              "}"
            ]
          }
        }
      ]
    },
