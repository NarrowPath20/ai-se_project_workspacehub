    {
      "name": "Verify rejected updates left the fixture unchanged",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  const fixture = json.data.find(comment => comment._id === pm.collectionVariables.get(\"commentId\"));",
              "  pm.test(\"Fixture text is unchanged\", () => pm.expect(fixture && fixture.content).to.equal(\"Edge-case fixture\"));",
              "}"
            ]
          }
        }
      ]
    },
