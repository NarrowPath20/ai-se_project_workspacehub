          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response envelope\", () => pm.expect(json.success).to.equal(true));",
              "  pm.test(\"Text is trimmed\", () => pm.expect(json.data.content).to.equal(\"Edge-case fixture\"));",
              "  pm.test(\"authorId comes from trusted context\", () => pm.expect(json.data.authorId).to.equal(pm.collectionVariables.get(\"ownerId\")));",
              "  pm.test(\"taskId comes from trusted context\", () => pm.expect(json.data.taskId).to.equal(pm.collectionVariables.get(\"taskId\")));",
              "  pm.test(\"organizationId comes from trusted context\", () => pm.expect(json.data.organizationId).to.equal(pm.collectionVariables.get(\"organizationId\")));",
              "  pm.collectionVariables.set(\"commentId\", json.data._id);",
              "}"
            ]
          }
        }
      ]
